{
    "name": "eunaumtenhoid/payments",
    "type": "phpbb-extension",
    "description": "Gateway central de pagamentos para o fórum, suportando Mercado Pago, Stripe, PayPal e Coinbase.",
    "homepage": "https://github.com/eunaumtenhoid/payments",
    "version": "1.0.0",
    "time": "2026-07-04",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "eunaumtenhoid",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0",
        "stripe/stripe-php": "*",
        "mercadopago/dx-php": "*",
        "paypal/paypal-checkout-sdk": "^1.0",
        "guzzlehttp/guzzle": "^7.13"
    },
    "extra": {
        "display-name": "Payments Gateway",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0"
        }
    },
    "autoload": {
        "psr-4": {
            "eunaumtenhoid\\payments\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
